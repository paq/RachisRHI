foreach(required IN ITEMS BUILD_DIR CONFIG TARGET SHADERS INCLUDE BACKENDS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()

string(REPLACE "|" ";" backends "${BACKENDS}")
set(binaries)
set(keys)
foreach(backend IN LISTS backends)
    if(backend STREQUAL "d3d12")
        list(APPEND binaries FillShader.dxil)
    elseif(backend STREQUAL "vulkan")
        list(APPEND binaries FillShader.spv)
        list(APPEND keys FillShader.spv.key)
    elseif(backend STREQUAL "metal")
        list(APPEND binaries FillShader.pnms)
        list(APPEND keys FillShader.metallib.key)
    else()
        message(FATAL_ERROR "Unknown backend '${backend}'.")
    endif()
endforeach()

function(rachis_hash_binaries output)
    set(hashes)
    foreach(binary IN LISTS binaries)
        if(NOT EXISTS "${SHADERS}/${binary}")
            message(FATAL_ERROR "The build wrote no ${SHADERS}/${binary}.")
        endif()
        file(SHA256 "${SHADERS}/${binary}" hash)
        list(APPEND hashes "${hash}")
    endforeach()
    set(${output} "${hashes}" PARENT_SCOPE)
endfunction()

rachis_hash_binaries(before)
file(READ "${INCLUDE}" include_text)
if(NOT include_text MATCHES "FILL_VALUE ([0-9]+)u")
    message(FATAL_ERROR "${INCLUDE} defines no FILL_VALUE.")
endif()
math(EXPR next_value "${CMAKE_MATCH_1} + 1")
string(REGEX REPLACE "FILL_VALUE [0-9]+u" "FILL_VALUE ${next_value}u" include_text "${include_text}")
file(WRITE "${INCLUDE}" "${include_text}")
file(SHA256 "${INCLUDE}" include_hash)

execute_process(
    COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config "${CONFIG}" --target "${TARGET}"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Rebuilding ${TARGET} after changing ${INCLUDE} failed (${status}).")
endif()
rachis_hash_binaries(after)

set(failures)
list(LENGTH binaries binary_count)
math(EXPR last "${binary_count} - 1")
foreach(index RANGE ${last})
    list(GET binaries ${index} binary)
    list(GET before ${index} hash_before)
    list(GET after ${index} hash_after)
    if(hash_before STREQUAL hash_after)
        list(APPEND failures "${binary} did not change after FILL_VALUE in the included file changed")
    endif()
endforeach()
foreach(key IN LISTS keys)
    file(READ "${SHADERS}/${key}" key_text)
    if(NOT key_text MATCHES "\ninclude_hash=${include_hash}\n")
        list(APPEND failures "${key} does not record the included file's current hash")
    endif()
    if(key STREQUAL "FillShader.metallib.key" AND NOT key_text MATCHES "\nsdk=[0-9]")
        list(APPEND failures "${key} does not record the macOS SDK version")
    endif()
endforeach()

if(failures)
    list(JOIN failures "\n  " failures)
    message(FATAL_ERROR "rachis_add_shader does not track the files a shader includes:\n  ${failures}")
endif()
message(STATUS "Changing an included file rebuilt ${binary_count} shader binaries.")
