if(NOT LIBRARY OR NOT NM)
    message(FATAL_ERROR "LIBRARY and NM are required.")
endif()
if(NOT DEFINED APPLE)
    if(CMAKE_HOST_APPLE OR LIBRARY MATCHES "\\.dylib$")
        set(APPLE TRUE)
    else()
        set(APPLE FALSE)
    endif()
endif()
if(APPLE)
    set(nm_args -gU)
    set(symbol_pattern "^_rachis_")
else()
    set(nm_args -D --defined-only)
    set(symbol_pattern "^rachis_")
endif()
execute_process(
    COMMAND "${NM}" ${nm_args} "${LIBRARY}"
    OUTPUT_VARIABLE symbols
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "${NM} failed for ${LIBRARY}.")
endif()
string(REPLACE "\n" ";" lines "${symbols}")
set(exported 0)
set(unexpected)
foreach(line IN LISTS lines)
    if(line MATCHES "^[0-9a-fA-F]* *([A-Za-z]) (.+)$")
        set(type "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")

        if(NOT APPLE AND (type STREQUAL "A" OR name MATCHES "^(_init|_fini|_edata|_end|__bss_start)$"))
            continue()
        endif()
        if(name MATCHES "${symbol_pattern}")
            math(EXPR exported "${exported} + 1")
        else()
            list(APPEND unexpected "${name}")
        endif()
    endif()
endforeach()
if(unexpected)
    list(JOIN unexpected "\n  " names)
    message(FATAL_ERROR "The Rachis C ABI exports non-rachis symbols:\n  ${names}")
endif()
if(exported EQUAL 0)
    message(FATAL_ERROR "No rachis_* symbols were exported from ${LIBRARY}.")
endif()
message(STATUS "Exported ${exported} rachis_* symbols and nothing else.")
