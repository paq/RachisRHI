foreach(required IN ITEMS NINJA BUILD_DIR NINJA_FILE FILE_NAME DIRECTORIES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()

function(rachis_normalize_path output path)
    string(REGEX REPLACE "^\"(.*)\"$" "\\1" path "${path}")
    file(TO_CMAKE_PATH "${path}" path)
    cmake_path(NORMAL_PATH path)
    string(REGEX REPLACE "(.)/+$" "\\1" path "${path}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${path}" path)
    endif()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

execute_process(
    COMMAND "${NINJA}" -C "${BUILD_DIR}" -f "${NINJA_FILE}" -t commands
    RESULT_VARIABLE status
    OUTPUT_VARIABLE commands
    ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "ninja -t commands failed for ${BUILD_DIR}/${NINJA_FILE} (${status}):\n${errors}")
endif()

rachis_normalize_path(file_name "${FILE_NAME}")
string(REPLACE ";" " " commands "${commands}")
string(REGEX MATCHALL "-E (copy_if_different|copy) [^&\r\n]*" copies "${commands}")
set(writers)
foreach(copy IN LISTS copies)
    string(REGEX REPLACE "^-E [a-z_]+ " "" arguments "${copy}")
    string(REGEX MATCHALL "\"[^\"]*\"|[^ \"]+" arguments "${arguments}")
    list(REMOVE_ITEM arguments "\"\"")
    list(LENGTH arguments argument_count)
    if(argument_count LESS 2)
        continue()
    endif()
    list(GET arguments 0 first)
    if(first STREQUAL "-t")
        list(GET arguments 1 destination)
        list(SUBLIST arguments 2 -1 sources)
    else()
        list(POP_BACK arguments destination)
        set(sources ${arguments})
    endif()
    rachis_normalize_path(destination "${destination}")
    cmake_path(GET destination FILENAME destination_name)
    if(destination_name STREQUAL file_name)
        cmake_path(GET destination PARENT_PATH destination)
    endif()
    foreach(source IN LISTS sources)
        rachis_normalize_path(source "${source}")
        cmake_path(GET source FILENAME source_name)
        if(source_name STREQUAL file_name)
            list(APPEND writers "${destination}")
        endif()
    endforeach()
endforeach()

set(failures)
set(checked)
set(directories ${writers})
list(REMOVE_DUPLICATES directories)
list(LENGTH writers writer_count)
foreach(directory IN LISTS directories)
    set(others ${writers})
    list(REMOVE_ITEM others "${directory}")
    list(LENGTH others other_count)
    math(EXPR count "${writer_count} - ${other_count}")
    if(count GREATER 1)
        list(APPEND failures "${count} build steps copy ${FILE_NAME} into ${directory}")
    endif()
endforeach()

string(REPLACE "|" ";" expected "${DIRECTORIES}")
foreach(directory IN LISTS expected)
    rachis_normalize_path(directory "${directory}")
    if(directory IN_LIST checked)
        continue()
    endif()
    list(APPEND checked "${directory}")
    if(NOT directory IN_LIST writers)
        list(APPEND failures "no build step copies ${FILE_NAME} into ${directory}")
    endif()
endforeach()

if(failures)
    list(JOIN failures "\n  " failures)
    message(FATAL_ERROR
        "Each output directory that holds an executable loading ${FILE_NAME} must get it from exactly one "
        "build step, so that a parallel build never writes the file twice at once:\n  ${failures}")
endif()
list(LENGTH checked checked_count)
message(STATUS "Directories that need ${FILE_NAME}: ${checked_count}. One build step copies it into each.")
