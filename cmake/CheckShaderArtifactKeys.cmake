foreach(required IN ITEMS KEYS OPTIONS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()

string(REPLACE "|" ";" keys "${KEYS}")
set(failures)
foreach(key IN LISTS keys)
    if(NOT EXISTS "${key}")
        list(APPEND failures "${key} does not exist")
        continue()
    endif()
    file(STRINGS "${key}" option_lines REGEX "^options=")
    if(NOT option_lines STREQUAL "options=${OPTIONS}")
        list(APPEND failures "${key} records '${option_lines}', but its shader was compiled with '${OPTIONS}'")
    endif()
endforeach()

if(failures)
    list(JOIN failures "\n  " failures)
    message(FATAL_ERROR "Each shader key must record every compiler option:\n  ${failures}")
endif()
list(LENGTH keys key_count)
message(STATUS "Shader keys checked: ${key_count}. Each records every compiler option.")
