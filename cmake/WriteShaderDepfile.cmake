cmake_minimum_required(VERSION 3.28)

foreach(required_variable IN ITEMS FORMAT INPUT OUTPUT TARGET)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required")
    endif()
endforeach()
if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "The shader compiler wrote no dependency file '${INPUT}'")
endif()

set(dependencies)
file(READ "${INPUT}" content)
string(REPLACE "\r\n" "\n" content "${content}")
if(FORMAT STREQUAL "dxc")
    string(REGEX REPLACE "[ \t]*\\\\\n[ \t]*" "\n" content "${content}")
    if(CMAKE_HOST_WIN32)
        string(REPLACE "\\" "/" content "${content}")
    endif()
    string(FIND "${content}" ": " separator)
    string(FIND "${content}" ":\n" line_separator)
    if(separator EQUAL -1 OR (NOT line_separator EQUAL -1 AND line_separator LESS separator))
        set(separator ${line_separator})
    endif()
    if(separator EQUAL -1)
        message(FATAL_ERROR "'${INPUT}' does not start with '<target>: '")
    endif()
    math(EXPR separator "${separator} + 2")
    string(SUBSTRING "${content}" ${separator} -1 content)
    string(REGEX MATCHALL "[^\n]+" lines "${content}")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(NOT line STREQUAL "")
            list(APPEND dependencies "${line}")
        endif()
    endforeach()
elseif(FORMAT STREQUAL "slangc" OR FORMAT STREQUAL "glslang")
    # slangc and glslang write Makefile rules that escape spaces, colons, and dollars with backslashes.
    string(REGEX REPLACE "\\\\\n" " " content "${content}")
    string(REGEX MATCHALL "(\\\\[^\n]|\\$\\$|[^ \t\n\\\\$])+" tokens "${content}")
    foreach(token IN LISTS tokens)
        if(token MATCHES "(^|[^\\\\])(\\\\\\\\)*:$")
            continue()
        endif()
        string(REGEX REPLACE "\\\\([^\n])" "\\1" token "${token}")
        string(REPLACE "$$" "$" token "${token}")
        list(APPEND dependencies "${token}")
    endforeach()
else()
    message(FATAL_ERROR "FORMAT must be dxc, slangc, or glslang (got '${FORMAT}')")
endif()
if(NOT dependencies)
    message(FATAL_ERROR "'${INPUT}' lists no dependencies")
endif()

function(rachis_depfile_path output path)
    if(CMAKE_HOST_WIN32)
        string(REPLACE "\\" "/" path "${path}")
    endif()
    cmake_path(ABSOLUTE_PATH path NORMALIZE)
    string(REPLACE "$" "$$" path "${path}")
    string(REPLACE "#" "\\#" path "${path}")
    string(REPLACE " " "\\ " path "${path}")
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

rachis_depfile_path(content "${TARGET}")
string(APPEND content ":")
set(written)
foreach(dependency IN LISTS dependencies)
    rachis_depfile_path(dependency "${dependency}")
    if(NOT dependency IN_LIST written)
        list(APPEND written "${dependency}")
        string(APPEND content " \\\n  ${dependency}")
    endif()
endforeach()
file(WRITE "${OUTPUT}" "${content}\n")
