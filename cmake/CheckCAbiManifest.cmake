cmake_minimum_required(VERSION 3.28)

foreach(required IN ITEMS HEADER MANIFEST)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "CheckCAbiManifest requires -D${required}=<existing path> (got '${${required}}').")
    endif()
endforeach()

file(READ "${HEADER}" header_raw)

string(REPLACE "\r\n" "\n" header_clean "${header_raw}")

string(REPLACE ";" "__RACHIS_SEMI__" header_clean "${header_clean}")
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " header_clean "${header_clean}")
string(REGEX REPLACE "//[^\n]*" "" header_clean "${header_clean}")

string(REGEX MATCH "#[ \t]*define[ \t]+RACHIS_ABI_VERSION[ \t]+([0-9]+)[uU]?" abi_match "${header_clean}")
if(NOT abi_match)
    message(FATAL_ERROR "Could not find #define RACHIS_ABI_VERSION in ${HEADER}.")
endif()
set(header_abi_version "${CMAKE_MATCH_1}")

string(REGEX REPLACE "\\\\\n" " " header_body "${header_clean}")
string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\\1" header_body "${header_body}")

string(REGEX MATCHALL "RACHIS_API" api_tokens "${header_body}")
list(LENGTH api_tokens api_token_count)

string(REPLACE "__RACHIS_SEMI__" ";" header_statements "${header_body}")
set(header_symbols)
foreach(statement IN LISTS header_statements)
    if(statement MATCHES "(^|[^A-Za-z0-9_])RACHIS_API([^A-Za-z0-9_]|$)")
        if(statement MATCHES "RACHIS_API[ \t\n*A-Za-z0-9_]*[^A-Za-z0-9_](rachis_[A-Za-z0-9_]+)[ \t\n]*\\(")
            list(APPEND header_symbols "${CMAKE_MATCH_1}")
        else()
            message(FATAL_ERROR "Unrecognized RACHIS_API declaration in ${HEADER}:\n${statement}")
        endif()
    endif()
endforeach()

list(LENGTH header_symbols header_symbol_count)
if(NOT api_token_count EQUAL header_symbol_count)
    message(FATAL_ERROR
        "Expected every RACHIS_API occurrence in ${HEADER} (${api_token_count}) to map to one rachis_* function "
        "(parsed ${header_symbol_count}).")
endif()
list(SORT header_symbols)
set(header_symbols_unique ${header_symbols})
list(REMOVE_DUPLICATES header_symbols_unique)
if(NOT header_symbols STREQUAL header_symbols_unique)
    message(FATAL_ERROR "Duplicate RACHIS_API symbol declarations found in ${HEADER}.")
endif()

file(STRINGS "${MANIFEST}" manifest_lines)
set(manifest_abi_version "")
set(manifest_symbols)
foreach(raw_line IN LISTS manifest_lines)
    string(STRIP "${raw_line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    if(manifest_abi_version STREQUAL "")
        if(line MATCHES "^RACHIS_ABI_VERSION=([0-9]+)$")
            set(manifest_abi_version "${CMAKE_MATCH_1}")
            continue()
        else()
            message(FATAL_ERROR
                "First non-comment entry in ${MANIFEST} must be RACHIS_ABI_VERSION=<N> (got '${line}').")
        endif()
    endif()
    if(NOT line MATCHES "^rachis_[a-z0-9_]+$")
        message(FATAL_ERROR "Invalid symbol '${line}' in ${MANIFEST}.")
    endif()
    list(APPEND manifest_symbols "${line}")
endforeach()

if(manifest_abi_version STREQUAL "")
    message(FATAL_ERROR "Missing RACHIS_ABI_VERSION=<N> in ${MANIFEST}.")
endif()
if(NOT manifest_abi_version STREQUAL header_abi_version)
    message(FATAL_ERROR
        "ABI version mismatch: ${HEADER} defines RACHIS_ABI_VERSION=${header_abi_version}, "
        "but ${MANIFEST} pins RACHIS_ABI_VERSION=${manifest_abi_version}.")
endif()

set(manifest_sorted ${manifest_symbols})
list(SORT manifest_sorted)
if(NOT manifest_symbols STREQUAL manifest_sorted)
    message(FATAL_ERROR "Symbols in ${MANIFEST} must be sorted lexicographically.")
endif()
set(manifest_unique ${manifest_symbols})
list(REMOVE_DUPLICATES manifest_unique)
if(NOT manifest_symbols STREQUAL manifest_unique)
    message(FATAL_ERROR "Duplicate symbols found in ${MANIFEST}.")
endif()

if(NOT header_symbols STREQUAL manifest_symbols)
    set(added ${header_symbols})
    list(REMOVE_ITEM added ${manifest_symbols})
    set(removed ${manifest_symbols})
    list(REMOVE_ITEM removed ${header_symbols})
    message(FATAL_ERROR
        "C ABI export surface in ${HEADER} does not match ${MANIFEST} (RACHIS_ABI_VERSION=${header_abi_version}).\n"
        "  Added in header without manifest update: ${added}\n"
        "  Removed from header without manifest update: ${removed}\n"
        "Adding, removing, or renaming any RACHIS_API export requires bumping RACHIS_ABI_VERSION in "
        "${HEADER} and updating ${MANIFEST}.")
endif()

if(NOT DEFINED LIBRARY OR "${LIBRARY}" STREQUAL "")
    return()
endif()
if(NOT EXISTS "${LIBRARY}")
    message(FATAL_ERROR "${LIBRARY} does not exist.")
endif()

function(rachis_read_exports output)
    execute_process(
        COMMAND ${ARGN}
        RESULT_VARIABLE status
        OUTPUT_VARIABLE exports
        ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        list(GET ARGN 0 tool)
        message(FATAL_ERROR "${tool} failed for ${LIBRARY} (${status}): ${errors}")
    endif()
    string(REPLACE "\r" "" exports "${exports}")
    set(${output} "${exports}" PARENT_SCOPE)
endfunction()

set(binary_symbols)
if(CMAKE_HOST_WIN32)
    if(DEFINED DUMPBIN AND NOT "${DUMPBIN}" STREQUAL "" AND EXISTS "${DUMPBIN}")
        rachis_read_exports(exports "${DUMPBIN}" /nologo /exports "${LIBRARY}")
        string(FIND "${exports}" "ordinal hint" table_start)
        if(NOT table_start EQUAL -1)
            string(SUBSTRING "${exports}" ${table_start} -1 exports)
            string(FIND "${exports}" "\n  Summary" table_end)
            if(NOT table_end EQUAL -1)
                string(SUBSTRING "${exports}" 0 ${table_end} exports)
            endif()
            string(REGEX MATCHALL "[^\n]+" export_lines "${exports}")
            list(REMOVE_AT export_lines 0)
            foreach(line IN LISTS export_lines)
                if(line MATCHES "^ +[0-9]+ +[0-9A-Fa-f]+ +([0-9A-Fa-f]+ +)?([^ ]+)")
                    list(APPEND binary_symbols "${CMAKE_MATCH_2}")
                endif()
            endforeach()
        endif()
    elseif(DEFINED READOBJ AND NOT "${READOBJ}" STREQUAL "" AND EXISTS "${READOBJ}")
        rachis_read_exports(exports "${READOBJ}" --coff-exports "${LIBRARY}")
        string(REGEX MATCHALL "Export {[^}]*}" export_blocks "${exports}")
        foreach(block IN LISTS export_blocks)
            if(block MATCHES "\n *Name: ([^\n]+)")
                list(APPEND binary_symbols "${CMAKE_MATCH_1}")
            else()
                list(APPEND binary_symbols "[NONAME]")
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "Pass -DDUMPBIN=<dumpbin> or -DREADOBJ=<llvm-readobj> to check the exports of ${LIBRARY}.")
    endif()
else()
    if(NOT DEFINED NM OR "${NM}" STREQUAL "" OR NOT EXISTS "${NM}")
        message(FATAL_ERROR "Pass -DNM=<nm> to check the exports of ${LIBRARY}.")
    endif()
    if(CMAKE_HOST_APPLE)
        rachis_read_exports(exports "${NM}" -gU "${LIBRARY}")
    else()
        rachis_read_exports(exports "${NM}" -D --defined-only "${LIBRARY}")
    endif()
    string(REGEX MATCHALL "[^\n]+" export_lines "${exports}")
    foreach(line IN LISTS export_lines)
        if(NOT line MATCHES "^[0-9A-Fa-f]* *([A-Za-z]) +([^ \t@]+)")
            continue()
        endif()
        set(type "${CMAKE_MATCH_1}")
        set(symbol "${CMAKE_MATCH_2}")
        if(NOT type MATCHES "^[B-MO-TV-Zui]$")
            continue()
        endif()
        if(CMAKE_HOST_APPLE)
            string(REGEX REPLACE "^_" "" symbol "${symbol}")
        elseif(symbol MATCHES "^(_init|_fini|_edata|_end|__bss_start)$")
            continue()
        endif()
        list(APPEND binary_symbols "${symbol}")
    endforeach()
endif()
list(SORT binary_symbols)
list(REMOVE_DUPLICATES binary_symbols)
if(NOT binary_symbols STREQUAL manifest_symbols)
    set(extra_exports ${binary_symbols})
    list(REMOVE_ITEM extra_exports ${manifest_symbols})
    set(missing_exports ${manifest_symbols})
    if(binary_symbols)
        list(REMOVE_ITEM missing_exports ${binary_symbols})
    endif()
    list(JOIN extra_exports " " extra_exports)
    list(JOIN missing_exports " " missing_exports)
    if(extra_exports STREQUAL "")
        set(extra_exports none)
    endif()
    if(missing_exports STREQUAL "")
        set(missing_exports none)
    endif()
    message(FATAL_ERROR
        "Exported symbols in ${LIBRARY} do not match ${MANIFEST}.\n"
        "  Unexpected exports: ${extra_exports}\n"
        "  Missing exports: ${missing_exports}")
endif()
list(LENGTH binary_symbols export_count)
message(STATUS "${LIBRARY} exports the ${export_count} symbols of ${MANIFEST} and nothing else.")
