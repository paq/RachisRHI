foreach(required IN ITEMS NINJA BUILD_DIR NINJA_FILE OUTPUTS SOURCES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()

function(rachis_normalize_path output path)
    file(TO_CMAKE_PATH "${path}" path)
    cmake_path(NORMAL_PATH path)
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${path}" path)
    endif()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

string(REPLACE "|" ";" outputs "${OUTPUTS}")
string(REPLACE "|" ";" sources "${SOURCES}")
list(LENGTH outputs output_count)
list(LENGTH sources source_count)
if(NOT output_count EQUAL source_count)
    message(FATAL_ERROR "OUTPUTS lists ${output_count} files but SOURCES lists ${source_count}.")
endif()

set(failures)
math(EXPR last "${output_count} - 1")
foreach(index RANGE ${last})
    list(GET outputs ${index} output)
    list(GET sources ${index} source)
    cmake_path(IS_PREFIX BUILD_DIR "${output}" NORMALIZE inside)
    if(inside)
        cmake_path(RELATIVE_PATH output BASE_DIRECTORY "${BUILD_DIR}")
    endif()
    execute_process(
        COMMAND "${NINJA}" -C "${BUILD_DIR}" -f "${NINJA_FILE}" -t query "${output}"
        RESULT_VARIABLE status
        OUTPUT_VARIABLE query
        ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        list(APPEND failures "${output} is not the output of any build step")
        continue()
    endif()
    string(REPLACE "\r" "" query "${query}")
    string(REGEX MATCH "\n  input: ([^\n]*)(\n.*)\n  outputs:" inputs "${query}")
    set(rule "${CMAKE_MATCH_1}")
    set(inputs "${CMAKE_MATCH_2}")
    if(NOT rule STREQUAL "CUSTOM_COMMAND")
        list(APPEND failures "${output} is built by a '${rule}' step, not by its own custom command")
        continue()
    endif()
    string(REGEX REPLACE "\n +(\\|\\|? )?" ";" inputs "${inputs}")
    set(normalized_inputs)
    foreach(input IN LISTS inputs)
        if(NOT input STREQUAL "")
            rachis_normalize_path(input "${input}")
            list(APPEND normalized_inputs "${input}")
        endif()
    endforeach()
    rachis_normalize_path(normalized_source "${source}")
    if(NOT normalized_source IN_LIST normalized_inputs)
        list(APPEND failures "the build step for ${output} does not depend on ${source}")
    endif()
endforeach()

if(failures)
    list(JOIN failures "\n  " failures)
    message(FATAL_ERROR
        "Each shader the tests load must be the output of its own build step that depends on its "
        "source, so that changing the source alone rebuilds it:\n  ${failures}")
endif()
message(STATUS "Shaders checked: ${output_count}. Each has its own build step that depends on its source.")
