{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-d3d12",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/windows-x64-d3d12",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "RACHIS_BACKENDS": "d3d12",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-vulkan",
      "inherits": "windows-x64-d3d12",
      "binaryDir": "${sourceDir}/out/build/windows-x64-vulkan",
      "cacheVariables": {
        "RACHIS_BACKENDS": "vulkan"
      }
    },
    {
      "name": "windows-x64-both",
      "inherits": "windows-x64-d3d12",
      "binaryDir": "${sourceDir}/out/build/windows-x64-both",
      "cacheVariables": {
        "RACHIS_BACKENDS": "both"
      }
    },
    {
      "name": "windows-x64-both-product",
      "description": "rachis.dll for packaging: both backends, no tests, so Catch2 is not fetched and RACHIS_TESTING hooks are not compiled in",
      "inherits": "windows-x64-both",
      "binaryDir": "${sourceDir}/out/build/windows-x64-both-product",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "linux-x64-vulkan",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/linux-x64-vulkan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "RACHIS_BACKENDS": "vulkan",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-x64-vulkan-product",
      "description": "librachis.so for packaging: Vulkan, no tests, so Catch2 is not fetched and RACHIS_TESTING hooks are not compiled in",
      "inherits": "linux-x64-vulkan",
      "binaryDir": "${sourceDir}/out/build/linux-x64-vulkan-product",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "macos-arm64-metal",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/macos-arm64-metal",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "RACHIS_BACKENDS": "metal",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64-vulkan",
      "inherits": "macos-arm64-metal",
      "binaryDir": "${sourceDir}/out/build/macos-arm64-vulkan",
      "cacheVariables": {
        "RACHIS_BACKENDS": "vulkan"
      }
    },
    {
      "name": "macos-arm64-metal-product",
      "description": "librachis.dylib for packaging: Metal, no tests, so Catch2 is not fetched and RACHIS_TESTING hooks are not compiled in",
      "inherits": "macos-arm64-metal",
      "binaryDir": "${sourceDir}/out/build/macos-arm64-metal-product",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-d3d12-debug",
      "configurePreset": "windows-x64-d3d12",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-vulkan-debug",
      "configurePreset": "windows-x64-vulkan",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-both-debug",
      "configurePreset": "windows-x64-both",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-vulkan-debug",
      "configurePreset": "linux-x64-vulkan",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-metal-debug",
      "configurePreset": "macos-arm64-metal",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-vulkan-debug",
      "configurePreset": "macos-arm64-vulkan",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-both-product-debug",
      "configurePreset": "windows-x64-both-product",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-both-product-release",
      "configurePreset": "windows-x64-both-product",
      "configuration": "Release"
    },
    {
      "name": "linux-x64-vulkan-product-debug",
      "configurePreset": "linux-x64-vulkan-product",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-vulkan-product-release",
      "configurePreset": "linux-x64-vulkan-product",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-metal-product-debug",
      "configurePreset": "macos-arm64-metal-product",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-metal-product-release",
      "configurePreset": "macos-arm64-metal-product",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-d3d12-small-medium",
      "configurePreset": "windows-x64-d3d12",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "size:small|size:medium"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-vulkan-small-medium",
      "inherits": "windows-x64-d3d12-small-medium",
      "configurePreset": "windows-x64-vulkan"
    },
    {
      "name": "windows-x64-both-small-medium",
      "inherits": "windows-x64-d3d12-small-medium",
      "configurePreset": "windows-x64-both"
    },
    {
      "name": "linux-x64-vulkan-small-medium",
      "inherits": "windows-x64-d3d12-small-medium",
      "configurePreset": "linux-x64-vulkan"
    },
    {
      "name": "macos-arm64-metal-small-medium",
      "inherits": "windows-x64-d3d12-small-medium",
      "configurePreset": "macos-arm64-metal"
    },
    {
      "name": "macos-arm64-metal-all",
      "configurePreset": "macos-arm64-metal",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "size:small|size:medium|size:large"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 4
      }
    },
    {
      "name": "macos-arm64-vulkan-small-medium",
      "inherits": "windows-x64-d3d12-small-medium",
      "configurePreset": "macos-arm64-vulkan"
    }
  ]
}
